# ===== Artifex Nexus runtime =====
# 默认安装路径锚定 ~/.artifexnexus（不要再用 ~/.openclaw）
ARTIFEX_NEXUS_HOME=~/.artifexnexus

# ===== OpenClaw Gateway（薄壳模式，安装到 ~/.artifexnexus/.openclaw/）=====
OPENCLAW_GATEWAY_WS=ws://127.0.0.1:19789
OPENCLAW_AUTH_TOKEN=
OPENCLAW_HOME=~/.artifexnexus/.openclaw

# ===== DCC 内 MCP Server =====
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT_BASE=8080

# ===== Web UI =====
NEXT_PUBLIC_API_BASE=http://127.0.0.1:18790
