{
  "id": "mcp-bridge",
  "name": "MCP Bridge",
  "description": "Bridge external MCP servers (WebSocket) into OpenClaw agent tools. Connects to Blender/UE/Maya/Max MCP Servers for AI-driven 3D operations.",
  "version": "5.0.0",
  "main": "index.js",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "mcp_blender-editor_run_python",
      "mcp_blender-editor_get_context",
      "mcp_unreal-editor_run_python",
      "mcp_maya-primary_run_python",
      "mcp_max-primary_run_python"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "servers": {
        "type": "object",
        "description": "MCP server definitions keyed by server name",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["websocket"],
              "description": "Transport type (only websocket supported)"
            },
            "url": {
              "type": "string",
              "description": "WebSocket URL (for type=websocket)"
            },
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Whether this server is enabled"
            }
          },
          "required": ["type", "url"]
        }
      }
    }
  },
  "uiHints": {
    "servers": {
      "label": "MCP Servers",
      "placeholder": "Add MCP server configurations"
    }
  }
}
