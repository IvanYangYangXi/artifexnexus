{
  "name": "@artifex-nexus/openclaw-gateway-plugin",
  "version": "0.0.0",
  "description": "OpenClaw Gateway plugin: bridges AI tool calls to DCC MCP servers via JSON-RPC over WebSocket",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "plugin.json"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "@artifex-nexus/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
