{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifexnexus.dev/schemas/manifest.schema.json",
  "title": "SkillManifest",
  "description": "Skill 包的 manifest.json — 元数据与依赖声明。枚举值与 contracts/data/categories.json 保持同步。",
  "type": "object",
  "required": ["manifest_version", "name", "version", "software"],
  "properties": {
    "manifest_version": { "const": "1.0" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "display_name": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].+)?$" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "software": {
      "type": "array",
      "minItems": 1,
      "description": "目标 DCC 软件列表，每项支持独立版本约束。与 contracts/data/categories.json §software 同步。",
      "items": {
        "type": "object",
        "required": ["dcc"],
        "properties": {
          "dcc": {
            "type": "string",
            "enum": ["general", "unreal_engine", "blender", "maya", "3ds_max", "houdini", "comfyui", "substance_painter", "substance_designer", "unity"]
          },
          "minVersion": { "type": "string", "description": "最低版本要求，如 '5.3'" },
          "maxVersion": { "type": "string", "description": "最高版本上限，如 '5.5'" }
        }
      }
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "风险级别（硬约束）。与 contracts/data/categories.json §risk_level 同步。"
    },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "entry_point": { "type": "string", "default": "__init__.py" },
    "hooks": {
      "type": "object",
      "description": "生命周期钩子（forward compat，STORY-0043/0044 实现）",
      "properties": {
        "on_dcc_startup": { "type": "string" },
        "on_dcc_shutdown": { "type": "string" }
      }
    }
  }
}
