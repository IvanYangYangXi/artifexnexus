{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifexnexus.dev/schemas/manifest.schema.json",
  "title": "SkillManifest",
  "description": "Skill 包的 manifest.json — 元数据与依赖声明。枚举值与 contracts/data/categories.json 保持同步。",
  "type": "object",
  "required": ["manifest_version", "name", "version", "software"],
  "properties": {
    "manifest_version": { "const": "1.0" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "display_name": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].+)?$" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "software": {
      "type": "string",
      "enum": ["universal", "unreal_engine", "blender", "maya", "3ds_max", "houdini", "comfyui"],
      "description": "目标 DCC 软件类型。与 contracts/data/categories.json §software 同步。"
    },
    "software_version": {
      "type": "object",
      "properties": {
        "min": { "type": "string" },
        "max": { "type": "string" }
      }
    },
    "category": {
      "type": "string",
      "pattern": "^[\\u4e00-\\u9fa5a-zA-Z0-9_-]{1,31}$",
      "description": "分类标签。预设值见 categories.json，允许用户自定义（中文/英文/数字/下划线/连字符，1-31字符）。"
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "风险级别（硬约束）。与 contracts/data/categories.json §risk_level 同步。"
    },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "entry_point": { "type": "string", "default": "__init__.py" },
    "skill_tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "minItems": 1
    },
    "hooks": {
      "type": "object",
      "description": "生命周期钩子（forward compat，STORY-0043/0044 实现）",
      "properties": {
        "on_dcc_startup": { "type": "string" },
        "on_dcc_shutdown": { "type": "string" }
      }
    }
  }
}
