{
  "id": "marketplace/模型批量加前缀后缀",
  "name": "Example-Blender-模型批量加前缀后缀",
  "description": "批量为 Blender 选中的对象添加命名前缀和/或后缀，支持自定义指定字符，符合资产命名规范标准",
  "version": "1.0.1",
  "author": "ArtClaw",
  "createdAt": "2026-04-13 18:00:00",
  "updatedAt": "2026-05-20 04:21:25",
  "defaultFilters": {
    "path": []
  },
  "implementation": {
    "entry": "main.py",
    "function": "rename_objects",
    "type": "script"
  },
  "inputs": [
    {
      "default": "sm",
      "description": "添加到对象名称前面的文本（留空则不添加）",
      "id": "prefix",
      "name": "前缀",
      "required": false,
      "type": "string"
    },
    {
      "default": "",
      "description": "添加到对象名称后面的文本（留空则不添加）",
      "id": "suffix",
      "name": "后缀",
      "required": false,
      "type": "string"
    },
    {
      "default": "_",
      "description": "前缀/后缀与原名之间的分隔符",
      "id": "separator",
      "name": "分隔符",
      "options": [
        "_",
        "-",
        ".",
        ""
      ],
      "required": false,
      "type": "select"
    },
    {
      "default": "selected",
      "description": "selected=当前选中对象 all=场景全部对象 collection=当前活跃集合",
      "id": "target",
      "name": "目标范围",
      "options": [
        "selected",
        "all",
        "collection"
      ],
      "required": false,
      "type": "select"
    }
  ],
  "outputs": [
    {
      "id": "renamed_count",
      "name": "重命名数量",
      "type": "number"
    },
    {
      "id": "renamed_objects",
      "name": "重命名清单",
      "type": "object"
    }
  ],
  "presets": [],
  "triggers": [],
  "software": [
    {
      "dcc": "blender",
      "maxVersion": "5.1.9",
      "minVersion": "5.0.0"
    }
  ]
}