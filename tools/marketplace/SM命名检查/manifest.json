{
  "id": "deae38ae-dc84-4398-a048-2075ee0c9913",
  "name": "Example-UE-SM-命名检查",
  "description": "静态网格体资产保存时触发前置命名检查，确保 /Game/_ToolManager 目录下的 StaticMesh 资产名称以 SM_ 为前缀，不符合则拦截保存并提示。",
  "version": "1.0.0",
  "author": "Ivan(杨己力)",
  "createdAt": "2026-04-26 00:23:00",
  "updatedAt": "2026-05-25 03:53:51",
  "defaultFilters": {
    "path": [
      {
        "pattern": "/Game/_ToolManager/**/*"
      }
    ],
    "typeFilter": {
      "types": [
        "StaticMesh",
        "StaticMeshActor"
      ]
    }
  },
  "implementation": {
    "entry": "main.py",
    "function": "check_sm_naming",
    "type": "script"
  },
  "inputs": [],
  "outputs": [
    {
      "description": "allow 或 reject",
      "id": "action",
      "label": "拦截动作",
      "name": "action",
      "type": "string"
    },
    {
      "id": "reason",
      "label": "拦截原因",
      "name": "reason",
      "type": "string"
    }
  ],
  "triggers": [
    {
      "conditions": {},
      "dcc": "unreal_engine",
      "enabled": false,
      "eventType": "asset.save.pre",
      "executionMode": "notify",
      "id": "on-static-mesh-pre-save",
      "name": "静态网格体保存前检查",
      "scheduleConfig": {
        "interval": "30m",
        "type": "interval"
      },
      "triggerType": "event",
      "useDefaultFilters": true
    },
    {
      "conditions": {},
      "dcc": "unreal_engine",
      "enabled": true,
      "eventType": "asset.place.post",
      "executionMode": "notify",
      "id": "f25ace5e-7d8e-4b6b-8cda-0849ee6efe28",
      "name": "静态网格体放置时检查",
      "scheduleConfig": {
        "interval": "30m",
        "type": "interval"
      },
      "triggerType": "event",
      "useDefaultFilters": false
    },
    {
      "conditions": {},
      "dcc": "unreal_engine",
