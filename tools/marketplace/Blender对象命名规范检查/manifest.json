{
  "id": "marketplace/Blender对象命名规范检查",
  "name": "Example-Blender对象命名规范检查",
  "description": "检查 Blender 场景中的对象命名是否符合命名规范（如 SM_/SK_/BP_ 等前缀）。可挂载触发器在保存时自动检查，也可手动运行查看命名报告",
  "version": "1.0.0",
  "author": "ArtClaw",
  "createdAt": "2026-04-26 23:00:00",
  "updatedAt": "2026-05-20 07:02:29",
  "defaultFilters": {
    "dcc": "blender",
    "path": [],
    "types": [
      "Mesh"
    ]
  },
  "implementation": {
    "entry": "main.py",
    "function": "check_naming",
    "type": "script"
  },
  "inputs": [
    {
      "default": "SM_,SK_,BP_,VFX_,MAT_,TEX_,CH_,ENV_,PROP_",
      "description": "逗号分隔的合规前缀，对象名必须以其中之一开头（留空跳过前缀检查）",
      "id": "prefixes",
      "name": "合规前缀列表",
      "required": false,
      "type": "string"
    },
    {
      "default": "",
      "description": "all=全场景对象 selected=选中对象 collection=当前活跃集合",
      "id": "target",
      "name": "检查范围",
      "options": [
        "all",
        "selected",
        "collection"
      ],
      "required": false,
      "type": "select"
    },
    {
      "default": false,
      "description": "跳过 Blender 默认生成的名称（如 Cube, Sphere, Camera, Light 等）",
      "id": "skip_default_names",
      "name": "跳过默认命名",
      "required": false,
      "type": "boolean"
    }
  ],
  "outputs": [
    {
      "id": "total",
      "name": "检查对象总数",
      "type": "number"
    },
    {
      "id": "violations",
      "name": "违规对象列表",
      "type": "object"
    },
    {
      "id": "pass_rate",
      "name": "通过率",
      "type": "string"
    }
  ],
  "presets": [],
  "triggers": [
    {
      "conditions": {},
      "dcc": "blender",
      "description": "保存文件时自动检查对象命名规范，以气泡通知显示结果，5 秒后自动消失",
      "enabled": true,
      "eventType": "file.save.post",
      "executionMode": "notify",
      "id": "61a94281-bfdf-4487-b4fd-4e2993d85f7b",
      "name": "Blender保存时命名检查",
      "scheduleConfig": {
        "interval": "30m",
        "type": "interval"
      },
      "triggerType": "event",
      "useDefaultFilters": true
    },
    {
      "conditions": {},
      "dcc": "blender",
      "description": "打开文件时自动检查对象命名规范，以弹窗显示结果，需手动关闭",
      "enabled": false,
      "eventType": "file.open.post",
      "executionMode": "silent",
      "id": "1a9c0360-28b2-4ee1-b192-d08dda5a90a6",
      "name": "Blender打开文件时命名检查",
      "scheduleConfig": {
        "interval": "30m",
        "type": "interval"
      },
      "triggerType": "event",
      "useDefaultFilters": true
    }
  ],
  "software": [
    {
      "dcc": "blender",
      "minVersion": "5.0.0",
      "maxVersion": "5.1.9"
    }
  ],
  "tags": [
    "规范检查"
  ]
}