{
  "id": "f00b1d41-d479-45d1-8786-57d6ca4380c1",
  "name": "Skill 合规检查器",
  "description": "检查 SKILL.md frontmatter（metadata.artifex_nexus.*）、manifest.json schema、software/dcc 枚举、依赖完整性、tags 格式、@skill_tool 合规。从 categories.json 运行时读取枚举。",
  "agentHint": "Python API: sys.path.insert(0, '{tool_dir}'); from main import check_skill_compliance; result = check_skill_compliance(source_root='skills', installed_root='~/.artifexnexus/.openclaw/workspace/skills')",
  "version": "1.3.0",
  "defaultFilters": {
    "path": [
      {
        "pattern": "$skills_installed/**/*"
      },
      {
        "pattern": "$project_root/skills/**/*"
      }
    ]
  },
  "implementation": {
    "type": "script",
    "entry": "main.py",
    "function": "check_skill_versions"
  },
  "inputs": [],
  "outputs": [
    {
      "id": "total_checked",
      "name": "检查Skill数",
      "type": "number"
    },
    {
      "id": "updates_available",
      "name": "可更新数",
      "type": "number"
    },
    {
      "id": "conflicts",
      "name": "冲突数",
      "type": "number"
    },
    {
      "id": "report",
      "name": "检查报告",
      "type": "string"
    }
  ],
  "triggers": [
    {
      "conditions": {},
      "enabled": true,
      "executionMode": "silent",
      "id": "periodic",
      "name": "每4小时检查",
      "scheduleConfig": {
        "interval": " 4h",
        "type": "interval"
      },
      "triggerType": "schedule",
      "useDefaultFilters": true
    },
    {
      "conditions": {
        "path": [
          {
            "pattern": "$skills_installed/**/*.py"
          },
          {
            "pattern": "$skills_installed/**/*.md"
          },
          {
            "pattern": "$skills_installed/**/*.json"
          },
          {
            "pattern": "$project_root/skills/**/*.py"
          },
          {
            "pattern": "$project_root/skills/**/*.md"
          },
          {
            "pattern": "$project_root/skills/**/*.json"
          }
        ]
      },
      "debounceMs": 3000,
      "enabled": true,
      "executionMode": "notify",
      "id": "on-skill-change",
      "name": "Skill文件变化时检查",
      "scheduleConfig": {
        "interval": "30m",
        "type": "interval"
      },
      "triggerType": "watch",
      "useDefaultFilters": false,
      "watchEvents": [
        "created",
        "modified",
        "deleted"
      ]
    }
  ],
  "author": "Ivan(杨己力)",
  "updatedAt": "2026-05-29 12:03:43",
  "software": [
    {
      "dcc": "general"
    }
  ]
}