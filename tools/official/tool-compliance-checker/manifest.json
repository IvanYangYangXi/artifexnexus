{
  "id": "da791ca4-ed3d-4ac3-9391-86aaa8560d98",
  "name": "工具合规检查器",
  "description": "定时/变更触发，硬编码检测工具是否合规（manifest格式、必填字段、脚本文件存在性等）",
  "agentHint": "通过 Tool Manager API 执行: POST /api/v1/tools/official%2Ftool-compliance-checker/execute。或从工具详情 API 获取 tool_path 字段，执行 {tool_path}/main.py。不要运行 openclaw skills check。",
  "version": "3.0.1",
  "defaultFilters": {
    "path": [
      {
        "pattern": "$project_root/tools/**/*"
      },
      {
        "pattern": "$tools_dir/**/*"
      }
    ]
  },
  "implementation": {
    "entry": "main.py",
    "function": "check_compliance",
    "type": "script"
  },
  "inputs": [
    {
      "default": "",
      "description": "扫描的工具根目录（为空时从 manifest defaultFilters 自动读取）",
      "id": "tools_dir",
      "name": "工具目录",
      "required": false,
      "type": "string"
    },
    {
      "default": false,
      "description": "如version格式错误则自动修正",
      "id": "fix_simple",
      "name": "自动修复简单问题",
      "required": false,
      "type": "boolean"
    },
    {
      "default": false,
      "description": "只检查在项目源码目录里有源码的工具，跳过平台安装但无源码的工具",
      "id": "source_only",
      "name": "仅检查源码工具",
      "required": false,
      "type": "boolean"
    }
  ],
  "outputs": [
    {
      "id": "total_checked",
      "name": "检查工具数",
      "type": "number"
    },
    {
      "id": "issues_found",
      "name": "问题数",
      "type": "number"
    },
    {
      "id": "report",
      "name": "检查报告",
      "type": "string"
    }
  ],
  "triggers": [
    {
      "conditions": {},
      "debounceMs": 3000,
      "enabled": true,
      "executionMode": "notify",
      "id": "on-change",
      "name": "工具变更时检查",
      "triggerType": "watch",
      "useDefaultFilters": true,
      "watchEvents": [
        "created",
        "modified"
      ]
    },
    {
      "conditions": {},
      "enabled": true,
      "executionMode": "silent",
      "id": "periodic",
      "name": "每30分钟全量检查",
      "scheduleConfig": {
        "interval": "4h",
        "type": "interval"
      },
      "triggerType": "schedule",
      "useDefaultFilters": true
    }
  ],
  "presets": [],
  "updatedAt": "2026-05-29 11:57:47",
  "author": "Ivan(杨己力)",
  "software": [
    {
      "dcc": "general"
    }
  ],
  "tags": []
}