{
  "name": "artifex-nexus",
  "version": "0.0.0",
  "private": true,
  "description": "Artifex Nexus: The AI-Agent Bridge for Digital Creation",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "py:install": "uv sync --all-packages",
    "py:test": "uv run pytest",
    "py:lint": "uv run ruff check .",
    "py:format": "uv run ruff format ."
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0",
    "prettier": "^3.3.0"
  },
  "workspaces": [
    "packages/platform/contracts/typescript",
    "packages/adapters/openclaw/gateway-plugin",
    "packages/apps/web",
    "apps/desktop"
  ]
}
