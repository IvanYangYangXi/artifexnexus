# --- Node / pnpm ---
node_modules/
.pnpm-store/
dist/
build/
.next/
.turbo/
*.tsbuildinfo

# --- Next.js static export ---
packages/apps/web/out/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.uv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# --- UE / C++ ---
packages/dcc/unreal/Binaries/
packages/dcc/unreal/Intermediate/
packages/dcc/unreal/Saved/
packages/dcc/unreal/DerivedDataCache/
*.obj
*.pdb

# --- Vendor (fork of OpenClaw, fetched via submodule or release) ---
vendor/openclaw/build/
vendor/openclaw/dist/
vendor/openclaw/node_modules/

# --- IDE / OS ---
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# --- Obsidian (keep settings, ignore local state) ---
.obsidian/workspace*
.obsidian/workspaces.json
.obsidian/cache
.obsidian/appearance.json

# --- Local env / secrets ---
.env
.env.*
!.env.example

# --- Installer artifacts ---
installer/dist/
*.zip
*.tar.gz

# --- Tauri / Rust ---
apps/desktop/src-tauri/target/

# --- Logs ---
logs/
*.log

# --- OpenSpec (本机 junction，docs/ 是单一信息源；详见 scripts/setup-openspec-links.mjs) ---
# 只追踪 openspec/config.yaml；changes/ 与 specs/ 子目录里的内容由本地脚本生成软链
openspec/changes/*
openspec/specs/*
!openspec/changes/.gitkeep
!openspec/specs/.gitkeep
!openspec/changes/archive/
!openspec/changes/archive/.gitkeep

# --- Spike 临时产物（大文件 + 可重生，不进 git）---
docs/specs/_spikes/*.json
!docs/specs/_spikes/.gitkeep
