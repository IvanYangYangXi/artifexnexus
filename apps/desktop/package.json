{
  "name": "@artifex-nexus/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Artifex Nexus Desktop Shell — Tauri 2 + React frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist node_modules",
    "tauri": "tauri",
    "package": "powershell -ExecutionPolicy Bypass -File ../../scripts/package.ps1",
    "package:portable": "powershell -ExecutionPolicy Bypass -File ../../scripts/package.ps1 -PortableOnly",
    "package:quick": "powershell -ExecutionPolicy Bypass -File ../../scripts/package.ps1 -SkipBuild -PortableOnly"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.10.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
