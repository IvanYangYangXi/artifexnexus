{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "artifex-nexus·山雀",
  "version": "0.1.0",
  "identifier": "com.artifex-nexus.desktop",
  "build": {
    "frontendDist": "../../../packages/apps/web/out",
    "devUrl": "http://localhost:18790",
    "beforeDevCommand": "pnpm --filter @artifex-nexus/web dev",
    "beforeBuildCommand": "pnpm --filter @artifex-nexus/web build"
  },
  "app": {
    "windows": [
      {
        "title": "artifex-nexus·山雀",
        "width": 1280,
        "height": 750,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../staging/packages": "packages",
      "../staging/skills": "skills",
      "../staging/tools": "tools",
      "../staging/pnpm-workspace.yaml": "pnpm-workspace.yaml"
    }
  }
}
